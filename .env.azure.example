# =============================================================================
# Vê AI · variáveis da INFRAESTRUTURA na Azure (lidas pelos scripts de scripts/)
# Copie para .env.azure (ignorado pelo Git): cp .env.azure.example .env.azure
# Evite aspas simples (') e ponto e vírgula (;) nas senhas: elas entram em comandos SQL e na URL JDBC.
# Os mesmos segredos vão para o Variable Group "veai-devops-secrets" do Azure DevOps.
# =============================================================================

# Região: chilecentral é a mais próxima de São Paulo entre as permitidas pela assinatura Azure for Students.
# Se a política da assinatura recusar o Azure SQL ou o App Service B1, troque por southafricanorth.
LOCATION=chilecentral
RESOURCE_GROUP=561413-veai-devops-rg
APP_SERVICE_PLAN=561413-veai-plan
WEB_APP_NAME=561413-veai-api

# Servidor do Azure SQL (nome único na Azure) e banco
SQL_SERVER_NAME=561413-veai-sql
SQL_DATABASE=veai

# Administrador do servidor: usado só pelos scripts 01 e sql.sh --admin (a API NÃO usa)
SQL_ADMIN_USER=veaiadmin
# 8+ caracteres com maiúscula, minúscula, número e símbolo
SQL_ADMIN_PASSWORD=

# Usuário do banco usado pela aplicação (contained user, criado pelo script 01; dono só do banco veai)
DB_USER=veai_app
DB_PASSWORD=

# Chave dos tokens JWT, 32+ caracteres (ex.: openssl rand -base64 48)
JWT_SECRET=

# OpenAI (descrição das fotos) e RabbitMQ da instância do CloudAMQP exclusiva da entrega de DevOps
OPENAI_API_KEY=
RABBITMQ_URL=

# Conta do seed usada pelo smoke test da Release (cidadã de demonstração)
SMOKE_EMAIL=ana.souza@veai.dev
SMOKE_SENHA=Veai@2026

# Opcional: seu IPv4 público para o firewall do Azure SQL. Vazio = detectado automaticamente.
CLIENT_IP=
