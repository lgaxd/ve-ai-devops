# =============================================================================
# Vê AI · variáveis da API para rodar LOCALMENTE (opcional)
# Copie para .env (ignorado pelo Git): cp .env.example .env
# Na nuvem, estas variáveis NÃO vêm daqui: a pipeline de Release grava os App Settings do
# Web App a partir do Variable Group "veai-devops-secrets" (veja docs/azure-devops.md).
# =============================================================================

# local = SQL Server do docker-compose | azure = Azure SQL (só faz sentido no App Service)
SPRING_PROFILES_ACTIVE=local

# --- SQL Server local (perfil local) -----------------------------------------
# Já têm valor padrão igual ao docker-compose.yml; só mude se usar outro SQL Server.
# LOCAL_DB_URL=jdbc:sqlserver://localhost:1433;databaseName=veai;encrypt=true;trustServerCertificate=true
# LOCAL_DB_USER=sa
# LOCAL_DB_PASSWORD=Veai@Local2026

# --- RabbitMQ ------------------------------------------------------------------
# Local: o do docker-compose. Nuvem: a instância do CloudAMQP da entrega de DevOps (amqps://...)
RABBITMQ_URL=amqp://veai:veai@localhost:5672

# --- Segurança -----------------------------------------------------------------
# JWT: no mínimo 32 caracteres aleatórios (ex.: openssl rand -base64 48)
JWT_SECRET=

# --- IA ----------------------------------------------------------------------
# falso = respostas fixas, sem custo | openai = GPT real (gasta créditos)
VEAI_IA_PROVEDOR=falso
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Vazio para gpt-5+/gpt-6 (só aceitam o padrão)
OPENAI_TEMPERATURE=
# Raciocínio do modelo: none (padrão, ~3 s por foto), low, medium, high, xhigh
OPENAI_REASONING_EFFORT=none

# --- Opcionais -----------------------------------------------------------------
VEAI_RAG_URL=
VEAI_RATE_LIMIT=20
VEAI_CORS_ORIGENS=*
PORT=8080

# --- Portas do docker compose (só se as padrão estiverem ocupadas) -------------------
# API_PORT=8080
# SQLSERVER_PORT=1433
# RABBITMQ_PORT=5672
# RABBITMQ_PAINEL_PORT=15672
